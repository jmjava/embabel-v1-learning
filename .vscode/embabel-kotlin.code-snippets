  "Embabel RepeatUntil (Kotlin)": {
    "scope": "kotlin",
    "prefix": "emb-repeat",
    "description": "RepeatUntilAcceptableBuilder loop",
    "body": [
      "val writer = actionContext.ai().withLlm(com.embabel.common.ai.model.LlmOptions.withAutoLlm())",
      "val reviewer = actionContext.ai().withLlm(com.embabel.common.ai.model.LlmOptions.withAutoLlm())",
      "return com.embabel.agent.api.common.workflow.loop.RepeatUntilAcceptableBuilder",
      "    .returning(${1:Story}::class.java)",
      "    .withMaxIterations(${2:5})",
      "    .withScoreThreshold(${3:0.8})",
      "    .repeating { ctx ->",
      "        val feedback = ctx.lastFeedbackOr(\"\")",
      "        writer.createObject(",
      "            \"\"\"",
      "            Write based on: \\${userInput.content}",
      "            Feedback: \\$feedback",
      "            \"\"\".trimIndent(),",
      "        )",
      "    }",
      "    .withEvaluator { ctx ->",
      "        reviewer.createObject(",
      "            \"\"\"",
      "            Score 0.0-1.0 and give feedback.",
      "            Result: \\${ctx.resultToEvaluate}",
      "            \"\"\".trimIndent(),",
      "        )",
      "    }",
      "    .build()",
      "    .asSubProcess(actionContext, ${1:Story}::class.java)"
    ]
  },
