  "Embabel Agent class (Kotlin)": {
    "scope": "kotlin",
    "prefix": "emb-agent",
    "description": "Embabel @Agent class with OperationContext",
    "body": [
      "import com.embabel.agent.api.annotation.AchievesGoal",
      "import com.embabel.agent.api.annotation.Action",
      "import com.embabel.agent.api.annotation.Agent",
      "import com.embabel.agent.api.annotation.Export",
      "import com.embabel.agent.api.common.OperationContext",
      "import com.embabel.agent.api.common.createObject",
      "import com.embabel.agent.domain.io.UserInput",
      "",
      "@Agent(description = \"${1:Describe what this agent does}\")",
      "class ${2:MyAgent} {",
      "",
      "    @Action",
      "    fun stepOne(userInput: UserInput, context: OperationContext): ${3:Draft} =",
      "        context.ai().withDefaultLlm().createObject(",
      "            \"\"\"",
      "            ${4:Transform the user input into a typed draft.}",
      "            User input: \\${userInput.content}",
      "            \"\"\".trimIndent(),",
      "        )",
      "",
      "    @AchievesGoal(",
      "        description = \"${5:Goal achieved description}\",",
      "        export = Export(remote = true, name = \"${6:myGoal}\"),",
      "    )",
      "    @Action",
      "    fun finish(draft: ${3:Draft}, context: OperationContext): ${7:Result} =",
      "        context.ai().withDefaultLlm().createObject(",
      "            \"\"\"",
      "            ${8:Produce the final result from the draft.}",
      "            Draft: \\$draft",
      "            \"\"\".trimIndent(),",
      "        )",
      "}"
    ]
  },
