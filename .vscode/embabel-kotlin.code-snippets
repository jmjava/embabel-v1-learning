  "Embabel State loop (Kotlin)": {
    "scope": "kotlin",
    "prefix": "emb-state",
    "description": "@State data classes with refine loop",
    "body": [
      "sealed interface ${1:LoopOutcome}",
      "",
      "@com.embabel.agent.api.annotation.State",
      "data class ${2:Working}(val data: String, val iteration: Int) : ${1:LoopOutcome} {",
      "    @Action(clearBlackboard = true)",
      "    fun refine(context: OperationContext): ${1:LoopOutcome} {",
      "        if (iteration >= ${3:2}) return ${4:Done}(data)",
      "        val improved = context.ai().withDefaultLlm().generateText(\"Improve: \\$data\")",
      "        return ${2:Working}(improved, iteration + 1)",
      "    }",
      "}",
      "",
      "@com.embabel.agent.api.annotation.State",
      "data class ${4:Done}(val data: String) : ${1:LoopOutcome} {",
      "    @AchievesGoal(description = \"${5:Loop complete}\")",
      "    @Action",
      "    fun finish(): ${6:Report} = ${6:Report}(data)",
      "}"
    ]
  },
  "Embabel Guardrail (Kotlin)": {
    "scope": "kotlin",
    "prefix": "emb-guardrail",
    "description": "UserInputGuardRail implementation",
    "body": [
      "class ${1:MyGuardRail} : com.embabel.agent.api.validation.guardrails.UserInputGuardRail {",
      "    override val name = \"${1:MyGuardRail}\"",
      "    override val description = \"${2:Reject unsafe topics}\"",
      "",
      "    override fun validate(",
      "        input: String,",
      "        blackboard: com.embabel.agent.core.Blackboard,",
      "    ): com.embabel.common.core.validation.ValidationResult {",
      "        if (input.lowercase().contains(\"${3:password}\")) {",
      "            return com.embabel.common.core.validation.ValidationResult(",
      "                isValid = false,",
      "                errors = listOf(",
      "                    com.embabel.common.core.validation.ValidationError(",
      "                        \"${4:blocked-topic}\",",
      "                        \"${5:Not allowed}\",",
      "                        com.embabel.common.core.validation.ValidationSeverity.CRITICAL,",
      "                    ),",
      "                ),",
      "            )",
      "        }",
      "        return com.embabel.common.core.validation.ValidationResult.VALID",
      "    }",
      "}",
      "",
      "// usage: .withGuardRails(${1:MyGuardRail}())"
    ]
  },
  "Embabel StuckHandler (Kotlin)": {
    "scope": "kotlin",
    "prefix": "emb-stuck",
    "description": "StuckHandler with REPLAN",
    "body": [
