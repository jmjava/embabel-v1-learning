  "Embabel DSL agent (Kotlin)": {
    "scope": "kotlin",
    "prefix": "emb-dsl",
    "description": "Kotlin DSL agent { } + @Bean registration",
    "body": [
      "import com.embabel.agent.api.common.createObject",
      "import com.embabel.agent.api.dsl.agent",
      "import com.embabel.agent.core.Agent",
      "import com.embabel.agent.domain.io.UserInput",
      "import org.springframework.context.annotation.Bean",
      "import org.springframework.context.annotation.Configuration",
      "",
      "data class ${1:Intermediate}(val text: String)",
      "data class ${2:Result}(val summary: String)",
      "",
      "fun ${3:myDslAgent}(): Agent = agent(",
      "    name = \"${4:MyDslAgent}\",",
      "    description = \"${5:What this DSL agent does}\",",
      ") {",
      "    transformation<UserInput, ${1:Intermediate}> { context ->",
      "        context.ai().withDefaultLlm().createObject(",
      "            \"Extract from: \\${context.input.content}\",",
      "        )",
      "    }",
      "",
      "    transformation<${1:Intermediate}, ${2:Result}> { context ->",
      "        context.ai().withDefaultLlm().createObject(",
      "            \"Summarize: \\${context.input.text}\",",
      "        )",
      "    }",
      "",
      "    goal(",
      "        name = \"${6:done}\",",
      "        description = \"${7:Finished}\",",
      "        satisfiedBy = ${2:Result}::class,",
      "    )",
      "}",
      "",
      "@Configuration",
      "class ${8:MyDslConfig} {",
      "    @Bean",
      "    fun ${9:myDslBean}(): Agent = ${3:myDslAgent}()",
      "}"
    ]
  },
