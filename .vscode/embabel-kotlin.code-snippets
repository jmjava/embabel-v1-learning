      "    @Action",
      "    fun finish(needed: ${4:Needed}): ${5:Out} = ${5:Out}(needed.toString())",
      "",
      "    override fun handleStuck(",
      "        agentProcess: com.embabel.agent.core.AgentProcess,",
      "    ): com.embabel.agent.api.common.StuckHandlerResult {",
      "        agentProcess.addObject(${4:Needed}(${6:\"seed\"}))",
      "        return com.embabel.agent.api.common.StuckHandlerResult(",
      "            message = \"${7:Seeded missing object}\",",
      "            handler = this,",
      "            code = com.embabel.agent.api.common.StuckHandlingResultCode.REPLAN,",
      "            agentProcess = agentProcess,",
      "        )",
      "    }",
      "}"
    ]
  },
