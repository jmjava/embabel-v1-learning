  "Embabel State loop": {
    "scope": "java",
    "prefix": "emb-state",
    "description": "@State looping records with clearBlackboard",
    "body": [
      "public sealed interface ${1:LoopOutcome} {}",
      "",
      "@com.embabel.agent.api.annotation.State",
      "public record ${2:Working}(String data, int iteration) implements ${1:LoopOutcome} {",
      "    @Action(clearBlackboard = true)",
      "    public ${1:LoopOutcome} refine(Ai ai) {",
      "        if (iteration >= ${3:2}) {",
      "            return new ${4:Done}(data);",
      "        }",
      "        var improved = ai.withDefaultLlm().generateText(\"Improve: \" + data);",
      "        return new ${2:Working}(improved, iteration + 1);",
      "    }",
      "}",
      "",
      "@com.embabel.agent.api.annotation.State",
      "public record ${4:Done}(String data) implements ${1:LoopOutcome} {",
      "    @AchievesGoal(description = \"${5:Loop complete}\")",
      "    @Action",
      "    public ${6:Report} finish() {",
      "        return new ${6:Report}(data);",
      "    }",
      "}"
    ]
  },
  "Embabel Guardrail": {
    "scope": "java",
    "prefix": "emb-guardrail",
    "description": "UserInputGuardRail + withGuardRails usage",
    "body": [
      "public static final class ${1:MyGuardRail} implements com.embabel.agent.api.validation.guardrails.UserInputGuardRail {",
      "    @Override",
      "    public String getName() {",
      "        return \"${1:MyGuardRail}\";",
      "    }",
      "",
      "    @Override",
      "    public String getDescription() {",
      "        return \"${2:Reject unsafe topics}\";",
      "    }",
      "",
      "    @Override",
      "    public com.embabel.common.core.validation.ValidationResult validate(",
      "            String input, com.embabel.agent.core.Blackboard blackboard) {",
      "        if (input != null && input.toLowerCase().contains(\"${3:password}\")) {",
      "            return new com.embabel.common.core.validation.ValidationResult(false, java.util.List.of(",
      "                    new com.embabel.common.core.validation.ValidationError(",
      "                            \"${4:blocked-topic}\",",
      "                            \"${5:Not allowed}\",",
      "                            com.embabel.common.core.validation.ValidationSeverity.CRITICAL",
      "                    )",
      "            ));",
      "        }",
      "        return com.embabel.common.core.validation.ValidationResult.Companion.getVALID();",
      "    }",
      "}",
      "",
      "// usage: ai.withDefaultLlm().withGuardRails(new ${1:MyGuardRail()}).createObject(...)"
    ]
  },
  "Embabel StuckHandler agent": {
    "scope": "java",
    "prefix": "emb-stuck",
    "description": "Agent implementing StuckHandler with REPLAN",
    "body": [
      "@Agent(description = \"${1:Self-unsticking agent}\")",
      "public class ${2:SelfUnstickingAgent} implements com.embabel.agent.api.common.StuckHandler {",
      "",
      "    @AchievesGoal(description = \"${3:Goal}\")",
      "    @Action",
      "    public ${4:Out} finish(${5:Needed} needed) {",
      "        return new ${4:Out}(needed.toString());",
      "    }",
      "",
      "    @Override",
      "    public com.embabel.agent.api.common.StuckHandlerResult handleStuck(",
      "            com.embabel.agent.core.AgentProcess agentProcess) {",
      "        agentProcess.addObject(new ${5:Needed}(${6:\"seed\"}));",
      "        return new com.embabel.agent.api.common.StuckHandlerResult(",
      "                \"${7:Seeded missing object}\",",
      "                this,",
      "                com.embabel.agent.api.common.StuckHandlingResultCode.REPLAN,",
      "                agentProcess",
      "        );",
      "    }",
      "}"
    ]
  },
  "Embabel AgentInvocation": {
    "scope": "java",
    "prefix": "emb-invoke",
    "description": "AgentInvocation + ProcessOptions",
    "body": [
      "var options = com.embabel.agent.core.ProcessOptions.DEFAULT.withVerbosity(",
      "        com.embabel.agent.core.Verbosity.DEFAULT.withShowPrompts(true)",
      ");",
      "var invocation = com.embabel.agent.api.invocation.AgentInvocation",
      "        .builder(${1:agentPlatform})",
      "        .options(options)",
      "        .build(${2:ResultType}.class);",
      "return invocation.invoke(new com.embabel.agent.domain.io.UserInput(${3:prompt}));"
    ]
  },
  "Embabel FakeOperationContext test": {
    "scope": "java",
    "prefix": "emb-test",
    "description": "Guided unit test with FakeOperationContext",
    "body": [
      "@org.junit.jupiter.api.Test",
      "void ${1:action_promptContainsCue}() {",
      "    var context = com.embabel.agent.test.unit.FakeOperationContext.create();",
      "    context.expectResponse(new ${2:Type}(${3:\"fake\"}));",
      "",
      "    var agent = new ${4:MyAgent}();",
      "    var result = agent.${5:action}(",
      "            new com.embabel.agent.domain.io.UserInput(\"${6:cue word}\"),",
      "            context.ai()",
      "    );",
      "",
      "    var prompt = context.getPromptRunner().getLlmInvocations()",
      "            .getFirst().getMessages().getFirst().getContent();",
      "    org.junit.jupiter.api.Assertions.assertTrue(prompt.contains(\"${6:cue word}\"), prompt);",
      "    org.junit.jupiter.api.Assertions.assertNotNull(result);",
      "}"
    ]
  },
