{
  "Embabel Agent class": {
    "scope": "java",
    "prefix": "emb-agent",
    "description": "Embabel @Agent class with a goal action",
    "body": [
      "import com.embabel.agent.api.annotation.AchievesGoal;",
      "import com.embabel.agent.api.annotation.Action;",
      "import com.embabel.agent.api.annotation.Agent;",
      "import com.embabel.agent.api.annotation.Export;",
      "import com.embabel.agent.api.common.Ai;",
      "import com.embabel.agent.domain.io.UserInput;",
      "",
      "@Agent(description = \"${1:Describe what this agent does}\")",
      "public class ${2:MyAgent} {",
      "",
      "    @Action",
      "    public ${3:Draft} stepOne(UserInput userInput, Ai ai) {",
      "        return ai.withDefaultLlm().createObject(",
      "                \"\"\"",
      "                ${4:Transform the user input into a typed draft.}",
      "                User input: %s",
      "                \"\"\".formatted(userInput.getContent()),",
      "                ${3:Draft}.class",
      "        );",
      "    }",
      "",
      "    @AchievesGoal(",
      "            description = \"${5:Goal achieved description}\",",
      "            export = @Export(remote = true, name = \"${6:myGoal}\"))",
      "    @Action",
      "    public ${7:Result} finish(${3:Draft} draft, Ai ai) {",
      "        return ai.withDefaultLlm().createObject(",
      "                \"\"\"",
      "                ${8:Produce the final result from the draft.}",
      "                Draft: %s",
      "                \"\"\".formatted(draft),",
      "                ${7:Result}.class",
      "        );",
      "    }",
      "}"
    ]
  },
  "Embabel Action createObject": {
    "scope": "java",
    "prefix": "emb-action",
