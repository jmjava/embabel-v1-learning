  "Embabel Condition methods": {
    "scope": "java",
    "prefix": "emb-condition",
    "description": "@Condition pair for ok/bad gates",
    "body": [
      "public static final String ${1:OK} = \"${2:okCondition}\";",
      "public static final String ${3:BAD} = \"${4:badCondition}\";",
      "",
      "@Condition(name = ${1:OK})",
      "public boolean ${5:isOk}(${6:Critique} critique) {",
      "    return critique.${7:accepted}();",
      "}",
      "",
      "@Condition(name = ${3:BAD})",
      "public boolean ${8:isBad}(${6:Critique} critique) {",
      "    return !critique.${7:accepted}();",
      "}"
    ]
  },
  "Embabel named binding action": {
    "scope": "java",
    "prefix": "emb-bind",
    "description": "Action with outputBinding + @RequireNameMatch consumer",
    "body": [
      "@Action(outputBinding = \"${1:namedValue}\")",
      "public ${2:Type} produce${3:Name}(Ai ai) {",
      "    return ai.withDefaultLlm().createObject(\"${4:Prompt}\", ${2:Type}.class);",
      "}",
      "",
      "@Action",
      "public ${5:Out} consume(@com.embabel.agent.api.annotation.RequireNameMatch ${2:Type} ${1:namedValue}, Ai ai) {",
      "    return ai.withDefaultLlm().createObject(",
      "            \"Use %s\".formatted(${1:namedValue}),",
      "            ${5:Out}.class",
      "    );",
      "}"
    ]
  },
  "Embabel Subagent handoff": {
    "scope": "java",
    "prefix": "emb-subagent",
    "description": "Call another agent as a tool via Subagent",
    "body": [
      "return context.promptRunner()",
      "        .withLlm(com.embabel.common.ai.model.LlmOptions.withAutoLlm())",
      "        .withTool(com.embabel.agent.api.tool.Subagent",
      "                .ofClass(${1:OtherAgent}.class)",
      "                .consuming(${2:UserInput}.class))",
      "        .createObject(",
      "                \"\"\"",
      "                ${3:Use the subagent, then summarize.}",
      "                User request: %s",
      "                \"\"\".formatted(userInput.getContent()),",
      "                ${4:ResultType}.class",
      "        );"
    ]
  },
  "Embabel RepeatUntil builder": {
    "scope": "java",
    "prefix": "emb-repeat",
    "description": "RepeatUntilAcceptableBuilder writer/reviewer loop",
    "body": [
      "var writer = actionContext.ai().withLlm(com.embabel.common.ai.model.LlmOptions.withAutoLlm());",
      "var reviewer = actionContext.ai().withLlm(com.embabel.common.ai.model.LlmOptions.withAutoLlm());",
      "return com.embabel.agent.api.common.workflow.loop.RepeatUntilAcceptableBuilder",
      "        .returning(${1:Story}.class)",
      "        .withMaxIterations(${2:5})",
      "        .withScoreThreshold(${3:0.8})",
      "        .repeating(ctx -> {",
      "            var feedback = ctx.lastFeedbackOr(\"\");",
      "            return writer.createObject(",
      "                    \"\"\"",
      "                    Write based on: %s",
      "                    Feedback: %s",
      "                    \"\"\".formatted(userInput.getContent(), feedback),",
      "                    ${1:Story}.class",
      "            );",
      "        })",
      "        .withEvaluator(ctx -> reviewer.createObject(",
      "                \"\"\"",
      "                Score 0.0-1.0 and give feedback.",
      "                Result: %s",
      "                \"\"\".formatted(ctx.getResultToEvaluate()),",
      "                com.embabel.agent.api.common.workflow.loop.TextFeedback.class",
      "        ))",
      "        .build()",
      "        .asSubProcess(actionContext, ${1:Story}.class);"
    ]
  },
  "Embabel Supervisor agent": {
    "scope": "java",
    "prefix": "emb-supervisor",
    "description": "@Agent with PlannerType.SUPERVISOR",
    "body": [
      "@Agent(",
      "        description = \"${1:Supervisor description}\",",
      "        planner = com.embabel.agent.api.common.PlannerType.SUPERVISOR",
      ")",
      "public class ${2:SupervisorAgent} {",
      "",
      "    @Action(description = \"${3:What this step does for the supervisor LLM}\")",
      "    public ${4:StepType} ${5:step}(UserInput userInput, Ai ai) {",
      "        return ai.withAutoLlm().createObject(",
      "                \"From: %s\".formatted(userInput.getContent()),",
      "                ${4:StepType}.class",
      "        );",
      "    }",
      "",
      "    @AchievesGoal(description = \"${6:Final goal}\")",
      "    @Action(description = \"${7:Compile final result}\")",
      "    public ${8:Result} finish(${4:StepType} step, UserInput userInput, Ai ai) {",
      "        return ai.withAutoLlm().createObject(",
      "                \"Finish using %s and %s\".formatted(step, userInput.getContent()),",
      "                ${8:Result}.class",
      "        );",
      "    }",
      "}"
    ]
  },
