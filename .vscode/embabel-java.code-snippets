    "body": [
      "@Action",
      "public ${1:OutType} ${2:actionName}(${3:InType} ${4:input}, Ai ai) {",
      "    return ai.withDefaultLlm().createObject(",
      "            \"\"\"",
      "            ${5:Prompt instructions.}",
      "            Input: %s",
      "            \"\"\".formatted(${4:input}),",
      "            ${1:OutType}.class",
      "    );",
      "}"
    ]
  },
